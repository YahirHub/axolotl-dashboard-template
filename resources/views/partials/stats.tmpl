{{ define "partials/stats" }}
      <section class="stats" data-skeleton="stats">
        <article class="card stat" data-info="Valor total simulado de activos en el portafolio.">
          <div class="stat-label">Valor del portafolio</div>
          <div class="stat-value money" data-mxn="1284275">$ 1,284,275</div>
          <div class="stat-change">+5.23% <span>(24 h)</span></div>
          <canvas id="sp1" class="spark"></canvas>
        </article>
        <article class="card stat">
          <div class="stat-label">Ganancia 24 horas</div>
          <div class="stat-value money" data-mxn="64285">$ 64,285</div>
          <div class="stat-change">+8.77%</div>
          <canvas id="sp2" class="spark"></canvas>
        </article>
        <article class="card stat">
          <div class="stat-label">Precisión Axolotl AI</div>
          <div class="stat-value">78.6%</div>
          <div class="stat-change">+6.21%</div>
          <canvas id="sp3" class="spark"></canvas>
        </article>
        <article class="card stat risk-stat">
          <div><div class="stat-label">Nivel de riesgo</div><div class="stat-value">Moderado</div></div>
          <button class="ring" id="riskRing" type="button" aria-label="Ver detalle de riesgo"></button>
        </article>
      </section>
{{ end }}

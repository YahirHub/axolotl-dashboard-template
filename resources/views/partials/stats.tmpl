{{ define "partials/stats" }}
      <section class="stats" data-skeleton="stats">
        {{ range .Metrics }}
        <article class="card stat {{ if .Ring }}risk-stat{{ end }}">
          <div>
            <div class="stat-label">{{ .Label }}</div>
            <div class="stat-value">{{ .Value }}</div>
            <div class="stat-change text-{{ .Tone }}">{{ .Change }} <span>{{ .Detail }}</span></div>
          </div>
          {{ if .Ring }}
          <button class="ring" id="riskRing" type="button" aria-label="Ver detalle de disponibilidad"></button>
          {{ else }}
          <canvas id="{{ .SparkID }}" class="spark"></canvas>
          {{ end }}
        </article>
        {{ end }}
      </section>
{{ end }}

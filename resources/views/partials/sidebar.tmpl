{{ define "partials/sidebar" }}
  <div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop"></div>
  <aside class="sidebar">
    <div class="sidebar-top">
      <button class="panel-toggle" id="sidebarToggle" type="button" aria-label="Ocultar sidebar" title="Ocultar/mostrar sidebar">
        <span class="panel-logo" aria-hidden="true"><img class="panel-brand-image" src="/assets/brand/axolotl.svg" alt=""></span>
        <span class="panel-action" aria-hidden="true"><i class="fa-solid fa-angles-left"></i></span>
      </button>
    </div>

    <nav class="nav" aria-label="Navegación principal">
      <button class="nav-item active" data-target="dashboard" type="button">
        <i class="fa-solid fa-house"></i><span>Dashboard</span>
      </button>

      <div class="nav-group" data-nav-group="management">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-briefcase"></i><span class="nav-label">Gestión</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <button class="nav-subitem" type="button" data-target="summary-section"><i class="fa-solid fa-diagram-project"></i><span>Proyectos</span></button>
          <button class="nav-subitem" type="button" data-target="signals-section"><i class="fa-solid fa-list-check"></i><span>Tareas</span></button>
          <button class="nav-subitem" type="button" data-target="news-section"><i class="fa-solid fa-clock-rotate-left"></i><span>Actividad</span></button>
        </div>
      </div>

      <div class="nav-group" data-nav-group="analytics">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-chart-line"></i><span class="nav-label">Analítica</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <button class="nav-subitem" type="button" data-target="sentiment-section"><i class="fa-solid fa-gauge-high"></i><span>Rendimiento</span></button>
          <button class="nav-subitem" type="button" data-target="prediction-section"><i class="fa-solid fa-wave-square"></i><span>Tendencias</span></button>
          <button class="nav-subitem" type="button" data-target="portfolio-section"><i class="fa-solid fa-chart-pie"></i><span>Distribución</span></button>
          <button class="nav-subitem" type="button" data-target="server-metrics-section"><i class="fa-solid fa-server"></i><span>Métricas servidor</span></button>
        </div>
      </div>

      <div class="nav-group" data-nav-group="workspace">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-layer-group"></i><span class="nav-label">Workspace</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <button class="nav-subitem" type="button" data-target="team-section"><i class="fa-solid fa-users"></i><span>Equipo</span></button>
          <button class="nav-subitem" type="button" data-target="schedule-section"><i class="fa-regular fa-calendar"></i><span>Agenda</span></button>
          <button class="nav-subitem" type="button" data-target="integrations-section"><i class="fa-solid fa-plug"></i><span>Integraciones</span></button>
        </div>
      </div>

      <button class="nav-item" data-action="alerts" type="button">
        <i class="fa-regular fa-bell"></i><span>Notificaciones</span>
      </button>

      <div class="nav-group" data-nav-group="settings">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-gear"></i><span class="nav-label">Ajustes</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <button class="nav-subitem" type="button" data-action="settings"><i class="fa-solid fa-sliders"></i><span>Preferencias</span></button>
          <button class="nav-subitem" type="button" data-action="theme"><i class="fa-solid fa-palette"></i><span>Tema</span></button>
          <button class="nav-subitem" type="button" data-action="components"><i class="fa-solid fa-layer-group"></i><span>Componentes UI</span></button>
          <button class="nav-subitem" type="button" data-target="code-lab-section"><i class="fa-solid fa-code"></i><span>Laboratorio UI</span></button>
          <button class="nav-subitem" type="button" data-action="security"><i class="fa-solid fa-shield-halved"></i><span>Seguridad</span></button>
        </div>
      </div>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer-note" aria-label="Estado de la aplicación">
      <span class="sidebar-status-dot"></span>
      <div>
        <strong>Axolotl</strong>
        <small>Backend conectado</small>
      </div>
    </div>
  </aside>
{{ end }}

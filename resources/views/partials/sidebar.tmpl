{{ define "partials/sidebar" }}
  <div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop"></div>
  <aside class="sidebar">
    <div class="sidebar-top">
      <button class="panel-toggle" id="sidebarToggle" type="button" aria-label="Ocultar sidebar" title="Ocultar/mostrar sidebar">
        <span class="panel-logo" aria-hidden="true"><img class="panel-brand-image" src="/assets/brand/axolotl.svg" alt=""></span>
        <span class="panel-action" aria-hidden="true"><i class="fa-solid fa-angles-left"></i></span>
      </button>
    </div>

    <nav class="nav" aria-label="Navegación principal">
      <a class="nav-item {{ if eq .ActiveRoute "dashboard" }}active{{ end }}" href="/dashboard" data-route="dashboard" {{ if eq .ActiveRoute "dashboard" }}aria-current="page"{{ end }}>
        <i class="fa-solid fa-house"></i><span>Dashboard</span>
      </a>

      <div class="nav-group {{ if or (eq .ActiveRoute "server") (eq .ActiveRoute "server-tasks") (eq .ActiveRoute "server-environment") }}open{{ end }}" data-nav-group="server">
        <button class="nav-item nav-group-toggle {{ if or (eq .ActiveRoute "server") (eq .ActiveRoute "server-tasks") (eq .ActiveRoute "server-environment") }}active{{ end }}" type="button" aria-expanded="{{ if or (eq .ActiveRoute "server") (eq .ActiveRoute "server-tasks") (eq .ActiveRoute "server-environment") }}true{{ else }}false{{ end }}">
          <i class="fa-solid fa-server"></i><span class="nav-label">Server</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <a class="nav-subitem {{ if eq .ActiveRoute "server" }}active{{ end }}" href="/servidor" data-route="server" {{ if eq .ActiveRoute "server" }}aria-current="page"{{ end }}>
            <i class="fa-solid fa-gauge-high"></i><span>Servidor</span>
          </a>
          <a class="nav-subitem {{ if eq .ActiveRoute "server-tasks" }}active{{ end }}" href="/servidor/tareas" data-route="server-tasks" {{ if eq .ActiveRoute "server-tasks" }}aria-current="page"{{ end }}>
            <i class="fa-solid fa-list-check"></i><span>Administrador de tareas</span>
          </a>
          <a class="nav-subitem {{ if eq .ActiveRoute "server-environment" }}active{{ end }}" href="/servidor/entorno" data-route="server-environment" {{ if eq .ActiveRoute "server-environment" }}aria-current="page"{{ end }}>
            <i class="fa-solid fa-microchip"></i><span>Entorno</span>
          </a>
        </div>
      </div>

      <a class="nav-item {{ if eq .ActiveRoute "files" }}active{{ end }}" href="/archivos" data-route="files" {{ if eq .ActiveRoute "files" }}aria-current="page"{{ end }}>
        <i class="fa-regular fa-folder-open"></i><span>Archivos</span>
      </a>

      <a class="nav-item {{ if eq .ActiveRoute "account" }}active{{ end }}" href="/cuenta" data-route="account" {{ if eq .ActiveRoute "account" }}aria-current="page"{{ end }}>
        <i class="fa-regular fa-user"></i><span>Cuenta</span>
      </a>

      <a class="nav-item {{ if eq .ActiveRoute "components" }}active{{ end }}" href="/componentes" data-route="components" {{ if eq .ActiveRoute "components" }}aria-current="page"{{ end }}>
        <i class="fa-solid fa-code"></i><span>Componentes</span>
      </a>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer-note" aria-label="Estado de la aplicación">
      <span class="sidebar-status-dot"></span>
      <div>
        <strong>Axolotl</strong>
        <small>Backend conectado</small>
      </div>
    </div>
  </aside>
{{ end }}

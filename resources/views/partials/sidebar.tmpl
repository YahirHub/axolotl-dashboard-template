{{ define "partials/sidebar" }}
  <div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop"></div>
  <aside class="sidebar">
    <div class="sidebar-top">
      <button class="panel-toggle" id="sidebarToggle" type="button" aria-label="Ocultar sidebar" title="Ocultar/mostrar sidebar">
        <span class="panel-logo" aria-hidden="true"><img class="panel-brand-image" src="/assets/brand/axolotl.svg" alt=""></span>
        <span class="panel-action" aria-hidden="true"><i class="fa-solid fa-angles-left"></i></span>
      </button>
    </div>

    <nav class="nav" aria-label="Navegación principal">
      <a class="nav-item {{ if eq .ActiveRoute "dashboard" }}active{{ end }}" href="/dashboard" data-route="dashboard" {{ if eq .ActiveRoute "dashboard" }}aria-current="page"{{ end }}>
        <i class="fa-solid fa-house"></i><span>Dashboard</span>
      </a>

      <div class="nav-group" data-nav-group="management">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-briefcase"></i><span class="nav-label">Gestión</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <a class="nav-subitem" href="/dashboard#summary-section"><i class="fa-solid fa-diagram-project"></i><span>Proyectos</span></a>
          <a class="nav-subitem" href="/dashboard#signals-section"><i class="fa-solid fa-list-check"></i><span>Tareas</span></a>
          <a class="nav-subitem" href="/dashboard#news-section"><i class="fa-solid fa-clock-rotate-left"></i><span>Actividad</span></a>
        </div>
      </div>

      <div class="nav-group" data-nav-group="analytics">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-chart-line"></i><span class="nav-label">Analítica</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <a class="nav-subitem" href="/dashboard#sentiment-section"><i class="fa-solid fa-gauge-high"></i><span>Rendimiento</span></a>
          <a class="nav-subitem" href="/dashboard#prediction-section"><i class="fa-solid fa-wave-square"></i><span>Tendencias</span></a>
          <a class="nav-subitem" href="/dashboard#portfolio-section"><i class="fa-solid fa-chart-pie"></i><span>Distribución</span></a>
        </div>
      </div>

      <div class="nav-group" data-nav-group="workspace">
        <button class="nav-item nav-group-toggle" type="button" aria-expanded="false">
          <i class="fa-solid fa-layer-group"></i><span class="nav-label">Workspace</span><i class="fa-solid fa-chevron-right nav-chevron"></i>
        </button>
        <div class="nav-submenu">
          <a class="nav-subitem" href="/dashboard#team-section"><i class="fa-solid fa-users"></i><span>Equipo</span></a>
          <a class="nav-subitem" href="/dashboard#schedule-section"><i class="fa-regular fa-calendar"></i><span>Agenda</span></a>
          <a class="nav-subitem" href="/dashboard#integrations-section"><i class="fa-solid fa-plug"></i><span>Integraciones</span></a>
        </div>
      </div>

      <a class="nav-item {{ if eq .ActiveRoute "server" }}active{{ end }}" href="/servidor" data-route="server" {{ if eq .ActiveRoute "server" }}aria-current="page"{{ end }}>
        <i class="fa-solid fa-server"></i><span>Servidor</span>
      </a>

      <a class="nav-item {{ if eq .ActiveRoute "account" }}active{{ end }}" href="/cuenta" data-route="account" {{ if eq .ActiveRoute "account" }}aria-current="page"{{ end }}>
        <i class="fa-regular fa-user"></i><span>Cuenta</span>
      </a>

      <a class="nav-item {{ if eq .ActiveRoute "components" }}active{{ end }}" href="/componentes" data-route="components" {{ if eq .ActiveRoute "components" }}aria-current="page"{{ end }}>
        <i class="fa-solid fa-code"></i><span>Componentes</span>
      </a>

      <button class="nav-item" data-action="alerts" type="button">
        <i class="fa-regular fa-bell"></i><span>Notificaciones</span>
      </button>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer-note" aria-label="Estado de la aplicación">
      <span class="sidebar-status-dot"></span>
      <div>
        <strong>Axolotl</strong>
        <small>Backend conectado</small>
      </div>
    </div>
  </aside>
{{ end }}

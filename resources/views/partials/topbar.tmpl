{{ define "partials/topbar" }}
      <header class="topbar">
        <div class="welcome">
          <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Abrir menú">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div class="welcome-copy">
            <h1>{{ .PageTitle }}</h1>
            <p>{{ .PageSubtitle }}</p>
          </div>
        </div>

        <div class="top-actions">
          <button class="top-btn" id="currencyBtn" type="button" aria-expanded="false">
            <i class="fa-solid fa-coins"></i><span id="currencyLabel">MXN / $</span><i class="fa-solid fa-angle-down"></i>
          </button>
          <button class="search-header-btn" id="searchBtn" type="button" aria-label="Buscar en Axolotl" title="Buscar (Ctrl/Cmd + K)">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span class="shortcut-dot">K</span>
          </button>
          <button class="top-btn icon" id="notificationBtn" type="button" aria-label="Notificaciones">
            <i class="fa-regular fa-bell"></i><span class="badge" id="notifBadge">3</span>
          </button>
          <button class="user-chip" id="userBtn" type="button" aria-label="Menú de usuario" aria-expanded="false">
            <span class="user-avatar-mini" id="headerUserAvatar">AX</span>
            <span class="user-chip-copy">
              <strong id="headerUserName">Usuario Axolotl</strong>
              <small id="headerUserRole">Administrador</small>
            </span>
            <i class="fa-solid fa-angle-down"></i>
          </button>

          <div class="dropdown currency hidden" id="currencyMenu">
            <div class="drop-head"><strong>Moneda de visualización</strong><small>Útil para widgets financieros o comerciales.</small></div>
            <button class="drop-item selected" data-currency="MXN"><span>🇲🇽</span><span class="grow">Peso mexicano</span><span class="check">✓</span></button>
            <button class="drop-item" data-currency="USD"><span>🇺🇸</span><span class="grow">Dólar estadounidense</span><span class="check"></span></button>
            <button class="drop-item" data-currency="JPY"><span>🇯🇵</span><span class="grow">Yen japonés</span><span class="check"></span></button>
          </div>

          <div class="dropdown hidden" id="userMenu">
            <a class="drop-item" href="/cuenta"><i class="fa-regular fa-user"></i><span>Editar cuenta</span></a>
            <a class="drop-item" href="/cuenta#preferencias"><i class="fa-solid fa-sliders"></i><span>Preferencias</span></a>
            <button class="drop-item" data-user-action="theme"><i class="fa-solid fa-palette"></i><span>Personalizar tema</span></button>
            <a class="drop-item" href="/componentes"><i class="fa-solid fa-layer-group"></i><span>Componentes UI</span></a>
            <a class="drop-item" href="/cuenta#seguridad"><i class="fa-solid fa-shield-halved"></i><span>Seguridad</span></a>
            <div class="drop-sep"></div>
            <button class="drop-item" data-user-action="logout"><i class="fa-solid fa-arrow-right-from-bracket"></i><span>Cerrar sesión</span></button>
          </div>
        </div>
      </header>
{{ end }}

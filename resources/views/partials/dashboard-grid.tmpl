{{ define "partials/dashboard-grid" }}
      <section class="dashboard-grid">
        <div class="left-col">
          <article class="card section sentiment-card" id="sentiment-section">
            <div class="card-head">
              <div class="card-title">Rendimiento operativo
                <button class="info-btn" type="button" data-tooltip="Índice demostrativo de entregas, calidad, disponibilidad y tiempos de respuesta."><i class="fa-regular fa-circle-question"></i></button>
              </div>
              <div class="periods" id="periodButtons">
                <button type="button" data-period="1H">1H</button>
                <button type="button" class="active" data-period="24H">24H</button>
                <button type="button" data-period="7D">7D</button>
                <button type="button" data-period="30D">30D</button>
              </div>
            </div>
            <div class="sentiment-body">
              <div class="gauge-wrap">
                <div class="gauge-label" id="gaugeLabel">Óptimo</div>
                <div class="gauge" id="gauge"><strong><span id="gaugeValue">84</span><small>/100</small></strong></div>
              </div>
              <div>
                <canvas id="sentChart" class="sent-chart"></canvas>
                <div class="chart-hover" id="sentHover">
                  <div class="metric-mini"><span>Periodo</span><strong id="sentHoverTime">18:00</strong></div>
                  <div class="metric-mini"><span>Índice</span><strong id="sentHoverValue">86 / 100</strong></div>
                  <div class="metric-mini"><span>Estado</span><strong class="up" id="sentHoverRead">Óptimo</strong></div>
                </div>
              </div>
            </div>
            <div class="caption" id="aiCaption"><i class="fa-solid fa-chart-line"></i>La operación mantiene buen ritmo con capacidad disponible.</div>
          </article>

          <article class="card section" id="summary-section" data-skeleton="summary">
            <div class="card-head">
              <div class="card-title">Proyectos destacados
                <button class="info-btn" type="button" data-tooltip="Ejemplos de módulos que pueden venir de una consulta ORM, API o servicio."><i class="fa-regular fa-circle-question"></i></button>
              </div>
              <button class="more-btn" id="summaryDetailsBtn" type="button">Ver detalle <i class="fa-solid fa-arrow-up-right-from-square"></i></button>
            </div>
            <div class="asset-grid">
              {{ range $index, $project := .Projects }}
              <button class="asset {{ if eq $index 0 }}selected{{ end }}" type="button" data-symbol="{{ $project.Key }}">
                <div class="coin {{ $project.Tone }}"><i class="fa-solid {{ $project.Icon }}"></i></div>
                <div class="asset-name">{{ $project.Name }} <small>{{ $project.Area }}</small></div>
                <div class="asset-price">{{ $project.Budget }}</div>
                <div class="asset-delta {{ if $project.ChangeDown }}down{{ end }}">{{ $project.Change }}</div>
                <canvas id="{{ $project.SparkID }}" class="tiny"></canvas>
              </button>
              {{ end }}
            </div>
            <div class="insight-panel hidden" id="summaryInsights" aria-hidden="true">
              <div>Estado<strong id="insightMomentum">En ritmo</strong></div>
              <div>Complejidad<strong id="insightVol">Media</strong></div>
              <div>Lectura<strong id="insightRead">Saludable</strong></div>
            </div>
          </article>

          <article class="card section" id="prediction-section">
            <div class="card-head">
              <div class="card-title"><span id="predictionTitle">Tendencia · Portal web</span>
                <button class="info-btn" type="button" data-tooltip="Serie demostrativa para mostrar progreso, demanda, conversión o cualquier métrica temporal."><i class="fa-regular fa-circle-question"></i></button>
              </div>
            </div>
            <div class="pred-meta">
              <div>Presupuesto<strong id="predCurrent">$420,000</strong></div>
              <div class="forecast">Objetivo semanal<strong id="predForecast">+8.20%</strong></div>
            </div>
            <canvas id="predChart" class="pred-chart"></canvas>
            <div class="chart-hover" id="predHover">
              <div class="metric-mini"><span>Periodo</span><strong id="predHoverTime">24:00</strong></div>
              <div class="metric-mini"><span>Índice</span><strong id="predHoverValue">84.20</strong></div>
              <div class="metric-mini"><span>Movimiento</span><strong class="up" id="predHoverMove">▲ +1.2</strong></div>
            </div>
          </article>

          <article class="card section" id="portfolio-section">
            <div class="card-head">
              <div class="card-title">Distribución de capacidad
                <button class="info-btn" type="button" data-tooltip="Componente reutilizable para carga de trabajo, presupuesto, inventario o composición."><i class="fa-regular fa-circle-question"></i></button>
              </div>
              <button class="more-btn" id="managePortfolioBtn" type="button">Administrar</button>
            </div>
            <div class="portfolio-body">
              <div class="donut-wrap">
                <canvas id="portChart" class="donut"></canvas>
                <div class="donut-center"><div id="portfolioCenter">Capacidad<strong>100%</strong><span>asignada</span></div></div>
              </div>
              <div class="legend" id="portfolioLegend">
                <button class="legend-row" type="button" data-index="0"><span class="dot" style="background:#F5B86F"></span><span>Producto</span><strong>34.0%</strong></button>
                <button class="legend-row" type="button" data-index="1"><span class="dot" style="background:#B58AF6"></span><span>Ventas</span><strong>22.0%</strong></button>
                <button class="legend-row" type="button" data-index="2"><span class="dot" style="background:#FC779B"></span><span>Operaciones</span><strong>19.0%</strong></button>
                <button class="legend-row" type="button" data-index="3"><span class="dot" style="background:#FCBBD5"></span><span>Analítica</span><strong>15.0%</strong></button>
                <button class="legend-row" type="button" data-index="4"><span class="dot" style="background:#765464"></span><span>Soporte</span><strong>10.0%</strong></button>
              </div>
            </div>
          </article>
        </div>

        <aside class="right-col">
          <article class="card market-card" id="market-section">
            <div class="card-head">
              <div class="card-title">Indicadores operativos
                <button class="info-btn" type="button" data-tooltip="Ejemplos de indicadores compactos para cualquier operación."><i class="fa-regular fa-circle-question"></i></button>
              </div>
            </div>
            <div class="market-list">
              <button class="market-row operation-row" type="button" data-operation="conversion">
                <div class="coin primary"><i class="fa-solid fa-filter-circle-dollar"></i></div>
                <div><strong>Conversión</strong><small>Objetivo mensual</small></div>
                <div class="market-price">18.4%<span>+2.1 pts</span></div>
              </button>
              <button class="market-row operation-row" type="button" data-operation="response">
                <div class="coin success"><i class="fa-solid fa-headset"></i></div>
                <div><strong>Tiempo de respuesta</strong><small>Soporte</small></div>
                <div class="market-price">2m 18s<span>-14%</span></div>
              </button>
              <button class="market-row operation-row" type="button" data-operation="orders">
                <div class="coin secondary"><i class="fa-solid fa-box"></i></div>
                <div><strong>Órdenes procesadas</strong><small>Últimas 24 h</small></div>
                <div class="market-price">1,842<span>+9.8%</span></div>
              </button>
              <button class="market-row operation-row" type="button" data-operation="backlog">
                <div class="coin warning"><i class="fa-solid fa-layer-group"></i></div>
                <div><strong>Backlog</strong><small>Pendientes activos</small></div>
                <div class="market-price">37<span class="down">+5</span></div>
              </button>
            </div>
            <button class="more-btn" id="allMarketsBtn" type="button">Ver reporte operativo <i class="fa-solid fa-arrow-right"></i></button>
          </article>

          <article class="card section" id="signals-section">
            <div class="card-head">
              <div class="card-title">Tareas prioritarias
                <button class="info-btn" type="button" data-tooltip="Lista reutilizable para tickets, órdenes, aprobaciones o pendientes."><i class="fa-regular fa-circle-question"></i></button>
              </div>
            </div>
            <div class="task-list">
              {{ range $index, $task := .Tasks }}
              {{ if lt $index 2 }}
              <button class="task-card" type="button" data-task="{{ $task.ID }}">
                <div class="task-card-top">
                  <span class="task-id">{{ $task.ID }}</span>
                  <span class="theme-chip bg-{{ $task.Tone }}-soft text-{{ $task.Tone }}">{{ $task.Priority }}</span>
                </div>
                <strong>{{ $task.Title }}</strong>
                <small>{{ $task.Project }} · {{ $task.Owner }}</small>
                <div class="task-progress"><span style="width:{{ $task.Progress }}%"></span></div>
                <div class="task-card-foot"><span>{{ $task.Progress }}%</span><span>{{ $task.Due }}</span></div>
              </button>
              {{ end }}
              {{ end }}
            </div>
            <button class="more-btn" id="allSignalsBtn" type="button">Ver todas las tareas <i class="fa-solid fa-arrow-right"></i></button>
          </article>

          <article class="card section news-card" id="news-section" data-skeleton="news">
            <div class="card-head"><div class="card-title">Actividad reciente
              <button class="info-btn" type="button" data-tooltip="Feed para auditoría, eventos, comentarios, alertas o cambios."><i class="fa-regular fa-circle-question"></i></button>
            </div></div>
            <div class="news-list">
              {{ range $index, $activity := .Activities }}
              <button class="news-item" type="button" data-news="{{ $index }}">
                <div class="activity-icon bg-{{ $activity.Tone }}-soft text-{{ $activity.Tone }}"><i class="fa-solid {{ $activity.Icon }}"></i></div>
                <div><strong>{{ $activity.Title }}</strong><small>{{ $activity.Detail }} · {{ $activity.Time }}</small></div>
              </button>
              {{ end }}
            </div>
            <button class="more-btn" id="allNewsBtn" type="button">Ver toda la actividad <i class="fa-solid fa-arrow-right"></i></button>
          </article>
        </aside>
      </section>
{{ end }}
